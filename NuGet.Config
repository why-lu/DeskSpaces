<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 自包含发布需要从微软官方源解析 .NET 运行时；无第三方包依赖。 -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="globalPackagesFolder" value="$(MSBuildThisFileDirectory).packages" />
  </config>
</configuration>
