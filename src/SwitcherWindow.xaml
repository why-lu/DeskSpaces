<Window x:Class="DeskSpaces.SwitcherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskSpaces" Width="470" Height="56" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True">
    <Border Background="{StaticResource Panel}" CornerRadius="12" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="8">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="＋" ToolTip="使用 Windows 新建桌面（Ctrl+Win+D）" Click="OnNew" />
                <Button Content="设置" Click="OnSettings" />
                <Button Content="退出" Click="OnExit" />
            </StackPanel>
            <StackPanel x:Name="DesktopButtons" Orientation="Horizontal" />
        </DockPanel>
    </Border>
</Window>
