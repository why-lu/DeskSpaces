<Window x:Class="DeskSpaces.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskSpaces 设置与恢复" Width="460" SizeToContent="Height" WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="Microsoft YaHei UI">
    <StackPanel Margin="26">
        <TextBlock Text="系统桌面与图标工作区" FontSize="22" FontWeight="SemiBold" Foreground="#172130" />
        <TextBlock Margin="0,10,0,18" TextWrapping="Wrap" LineHeight="23" Foreground="#4D5969"
                   Text="预览模式只操作图标副本，不影响原桌面。接管模式将隐藏系统原图标并嵌入本层；关闭软件会恢复原图标。真实文件在两种模式下都不会移动。" />
        <CheckBox x:Name="NativeModeCheck" Content="接管系统桌面（当前为实验功能）" FontSize="14" Margin="0,0,0,18" />
        <TextBlock Text="系统快捷键：Ctrl+Win+D 新建；Ctrl+Win+←/→ 切换；Ctrl+Win+F4 关闭。" TextWrapping="Wrap" Foreground="#4D5969" Margin="0,0,18,0" />
        <Button Content="保存设置" Click="OnApply" HorizontalAlignment="Left" Padding="18,9" Foreground="#172130" />
        <Button Content="恢复原桌面并退出" Click="OnExit" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="18,9" Foreground="#9C2737" />
    </StackPanel>
</Window>
