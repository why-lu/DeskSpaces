<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).packages\</RestorePackagesPath>
